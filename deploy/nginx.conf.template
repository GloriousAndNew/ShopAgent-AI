# 完整 nginx.conf 模板。替换 YOUR_DOMAIN、证书路径后先运行 nginx -t。
worker_processes auto;
pid /tmp/nginx.pid;
error_log /var/log/nginx/error.log warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    # 不记录请求体、查询串、Authorization、真实IP。
    log_format shopagent '$time_iso8601 $request_method $uri $status $request_time';
    access_log /var/log/nginx/access.log shopagent;
    limit_req_zone $binary_remote_addr zone=site:10m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=chat:10m rate=30r/m;
    limit_req_status 429;
    client_max_body_size 512k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    upstream shopagent { server 127.0.0.1:8001; }
    server {
        listen 80 default_server;
        server_name _;
        return 404;
    }
    server {
        listen 80;
        server_name YOUR_DOMAIN;
        location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
        location / { return 308 https://YOUR_DOMAIN$request_uri; }
    }
    server {
        listen 443 ssl;
        server_name YOUR_DOMAIN;
        if ($host != YOUR_DOMAIN) { return 404; }
        ssl_certificate /etc/shopagent/tls/fullchain.pem;
        ssl_certificate_key /etc/shopagent/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=86400" always;
        limit_req zone=site burst=20 nodelay;
        # 只支持 Nginx 直接面向顾客；CDN/多层代理需另外验证来源与限流。
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 180s;
        proxy_request_buffering on;
        location = /internal { return 404; }
        location ^~ /internal/ { return 404; }
        location = /docs { return 404; }
        location = /redoc { return 404; }
        location = /openapi.json { return 404; }
        location = /auth/login {
            limit_req zone=site burst=20 nodelay;
            limit_req zone=auth burst=5 nodelay;
            proxy_pass http://shopagent;
        }
        location = /auth/guest {
            limit_req zone=site burst=20 nodelay;
            limit_req zone=auth burst=5 nodelay;
            proxy_pass http://shopagent;
        }
        location = /chat {
            limit_req zone=site burst=20 nodelay;
            limit_req zone=chat burst=5 nodelay;
            proxy_pass http://shopagent;
        }
        location / { proxy_pass http://shopagent; }
    }
}
